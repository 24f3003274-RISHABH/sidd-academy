# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Render / Express Server)
# ==============================================================================
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
CORS_ORIGIN=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Razorpay Secrets
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Resend Email OTP Provider (Production)
RESEND_API_KEY=re_your_resend_api_key_here
OTP_EMAIL_FROM=Sidd Academy <no-reply@siddacademy.com>

# MSG91 SMS OTP Provider for Indian Mobile Numbers (+91)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here
MSG91_SENDER_ID=SIDDAC

# OTP Security & Rate Parameters
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
FROM_NAME=Sidd Academy
FROM_EMAIL=no-reply@siddacademy.com
